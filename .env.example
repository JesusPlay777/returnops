# Docker Compose
COMPOSE_PROJECT_NAME=returnops

# PostgreSQL
POSTGRES_DB=returnops
POSTGRES_USER=returnops
POSTGRES_PASSWORD=returnops_local
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Production providers supply a complete URL; leave empty for local Compose.
DATABASE_URL=

# Django
DJANGO_SECRET_KEY=replace-this-value-outside-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
RETURNOPS_VISITOR_SESSION_TTL_HOURS=24

# Next.js
# Optional browser override. Leave empty to use the same-origin API proxy.
NEXT_PUBLIC_API_URL=
BACKEND_INTERNAL_URL=http://backend:8000
